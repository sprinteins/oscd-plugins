{
	"name": "@oscd-plugins/type-designer",
	"private": true,
	"version": "3.16.2",
	"type": "module",
	"source": "src/plugin.ts",
	"scripts": {
		"//====== DEV ======//": "",
		"dev": "vite",
		"//====== BUILD ======//": "",
		"build": "vite build",
		"build:watch": "vite build --watch",
		"preview": "vite preview",
		"//====== INTEGRATED ======//": "",
		"integrated": "concurrently 'npm:build:watch' 'npm:preview'",
		"//====== SVELTE ======//": "",
		"check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
		"//====== TEST ======//": "",
		"test": "vitest --config vitest.config.ts",
		"test:run": "vitest --config vitest.config.ts --run",
		"test:coverage": "vitest --config vitest.config.ts --run --coverage",
		"e2e": "playwright test --config playwright.config.ts",
		"e2e:ui": "playwright test --config playwright.config.ts --ui",
		"e2e:report": "playwright show-report"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/plugin.d.ts",
			"default": "./dist/plugin.js"
		}
	},
	"devDependencies": {
		"@oscd-plugins/core-api": "workspace:^",
		"@oscd-plugins/core-standard": "workspace:^",
		"@oscd-plugins/core-ui-svelte": "workspace:^",
		"@playwright/test": "^1.57.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@tsconfig/svelte": "^5.0.4",
		"@types/uuid": "^10.0.0",
		"@vitest/coverage-v8": "^4.1.10",
		"autoprefixer": "^10.4.20",
		"concurrently": "^7.6.0",
		"jsdom": "^21.1.2",
		"lucide-svelte": "^0.469.0",
		"postcss": "^8.4.49",
		"svelte": "^5.19.8",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^3.4.15",
		"tailwindcss-animate": "^1.0.7",
		"tslib": "^2.8.0",
		"typescript": "~5.6.2",
		"uuid": "^10.0.0",
		"vite": "6.1.0",
		"vite-plugin-dts": "^4.5.0",
		"vitest": "^4.1.10"
	}
}