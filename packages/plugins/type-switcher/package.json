{
	"name": "@oscd-plugins/type-switcher",
	"private": true,
	"version": "0.0.20",
	"type": "module",
	"scripts": {
		"//====== DEV ======//": "",
		"dev": "vite",
		"//====== BUILD ======//": "",
		"build": "vite build",
		"build:watch": "vite build --watch",
		"preview": "vite preview",
		"//====== INTEGRATED ======//": "",
		"integrated": "concurrently 'npm:build:watch' 'npm:preview'",
		"//====== TEST ======//": "",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"//====== SVELTE ======//": "",
		"check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
		"//====== CI ======//": "",
		"biome:check": "biome check src",
		"ci-tests": "pnpm run biome:check && pnpm run check && pnpm run build && pnpm run test:coverage"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/plugin.d.ts",
			"default": "./dist/plugin.js"
		}
	},
	"devDependencies": {
		"@oscd-plugins/core": "workspace:^",
		"@oscd-plugins/core-api": "workspace:^",
		"@oscd-plugins/core-standard": "workspace:^",
		"@oscd-plugins/core-ui-svelte": "workspace:^",
		"@oscd-plugins/ui": "workspace:^",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@tsconfig/svelte": "^5.0.4",
		"@types/node": "^22.19.3",
		"@vitest/coverage-v8": "^4.1.10",
		"autoprefixer": "^10.4.20",
		"concurrently": "^7.6.0",
		"jsdom": "^21.1.2",
		"postcss": "^8.4.49",
		"sass": "^1.106.1",
		"svelte": "^5.17.0",
		"svelte-check": "^4.1.2",
		"tailwindcss": "^3.4.15",
		"tailwindcss-animate": "^1.0.7",
		"tslib": "^2.8.0",
		"typescript": "~5.6.2",
		"vite": "^6.0.3",
		"vite-plugin-dts": "^4.4.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@material/typography": "^14.0.0",
		"@smui/chips": "8.0.0-beta.3",
		"@smui/icon-button": "^8.0.3",
		"@smui/snackbar": "8.0.0-beta.3"
	}
}
